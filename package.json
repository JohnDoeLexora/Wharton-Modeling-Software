{
  "name": "gao-modeling-toolkit",
  "private": true,
  "version": "5.0.0",
  "type": "module",
  "description": "Exploration toolkit for the Wharton Investment Competition Laura Gao case. Not an investment recommendation.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "parity": "sh bend/parity.sh",
    "verify": "npm test && npm run build && bend bend/laws/LAWS.bend --verdict && bend bend/laws/FAN.bend --verdict && npm run parity",
    "bend:demo": "bend bend/main.bend",
    "bend:laws": "bend bend/laws/LAWS.bend --verdict && bend bend/laws/FAN.bend --verdict",
    "bend:check": "sh bend/check.sh",
    "sweep": "vite-node scripts/sweep.ts"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}
